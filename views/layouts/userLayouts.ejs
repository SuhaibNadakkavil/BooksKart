<!DOCTYPE html>
<html lang="en">

<%- include('../partials/userPartials/userHead', { title }) %>

<body class="min-h-screen flex flex-col bg-[#FAFAF8] text-[#121212]">

    <%- include('../partials/userPartials/userHeader', { headerType }) %>

    <% if (error) { %>
        <div class="max-w-6xl mx-auto px-4 mt-6">
            <div class="border border-[#121212] p-4 text-sm font-medium">
                <%= error %>
            </div>
        </div>
    <% } %>

    <main class="flex-grow w-full max-w-6xl mx-auto px-4 py-10">
        <%- body %>
    </main>

    <%- include('../partials/userPartials/userFooter') %>

    <%- include('../partials/userPartials/userScripts') %>

</body>
</html>
