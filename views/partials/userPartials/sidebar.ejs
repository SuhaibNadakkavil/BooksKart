<!-- Desktop Sidebar -->
<aside class="hidden lg:block w-52 shrink-0 lg:sticky lg:top-24">

  <div class="space-y-4">

      <p class="text-[14px] font-medium tracking-widest opacity-60 mb-6">
        ACCOUNT
      </p>

      <nav class="flex flex-col gap-2 text-[16px]">

        <% 
          const activeClass='bg-gray-200 border-l-4 shadow-md hover:translate-x-2' ; 
          const inactiveClass='hover:translate-x-2 hover:bg-white hover:shadow-md' ; 
        %>

        <a href="/profile" class="px-4 py-3 transition-all duration-300 transform rounded-lg
          <%= activePage === 'profile' ? activeClass : inactiveClass %>">
          Profile
        </a>

        <a href="/orders" class="px-4 py-3 transition-all duration-300 transform rounded-lg
          <%= activePage === 'orders' ? activeClass : inactiveClass %>">
          My Orders
        </a>

        <a href="/wallet" class="px-4 py-3 transition-all duration-300 transform rounded-lg
          <%= activePage === 'wallet' ? activeClass : inactiveClass %>">
          Wallet
        </a>

        <a href="/profile/address" class="px-4 py-3 transition-all duration-300 transform rounded-lg
          <%= activePage === 'address' ? activeClass : inactiveClass %>">
          Address
        </a>

        <a href="/referral" class="px-4 py-3 transition-all duration-300 transform rounded-lg
              <%= activePage === 'refer' ? activeClass : inactiveClass %>">
          Refer & Earn
        </a>

      </nav>

      <form action="/logout" method="POST" id="logoutFormDesktop">
        <button type="button"
                class="text-red-600 px-4 py-3 transition-all duration-300 transform hover:translate-x-2 hover:bg-white rounded-lg hover:shadow-md tracking-widest logoutBtn">
          Sign Out
        </button>
      </form>

  </div>
</aside>


<!-- Mobile Drawer -->
<div id="mobileSidebar"
     class="fixed inset-0 z-50 hidden lg:hidden">

  <!-- Overlay -->
  <div id="sidebarOverlay"
       class="absolute inset-0 bg-black bg-opacity-30 opacity-0 transition-opacity duration-300">
  </div>

  <!-- Drawer -->
  <div id="sidebarPanel"
       class="absolute left-0 top-0 h-full w-72 bg-[#FAFAF8] p-8 
              transform -translate-x-full transition-transform duration-300">

    <div class="flex justify-between items-center mb-10">
      <p class="text-[18px] font-semibold">Account</p>
      <button id="closeSidebar"
              class="text-[18px] font-medium">
        ✕
      </button>
    </div>

    <nav class="flex flex-col gap-2 text-[16px]">
      <a href="/profile" class="px-4 py-3 transition-all duration-300 transform rounded-lg
          <%= activePage === 'profile' ? activeClass : inactiveClass %>">
          Profile
        </a>

        <a href="/orders" class="px-4 py-3 transition-all duration-300 transform rounded-lg
          <%= activePage === 'orders' ? activeClass : inactiveClass %>">
          My Orders
        </a>

        <a href="/wallet" class="px-4 py-3 transition-all duration-300 transform rounded-lg
          <%= activePage === 'wallet' ? activeClass : inactiveClass %>">
          Wallet
        </a>

        <a href="/profile/address" class="px-4 py-3 transition-all duration-300 transform rounded-lg
          <%= activePage === 'address' ? activeClass : inactiveClass %>">
          Address
        </a>

        <a href="/referral" class="px-4 py-3 transition-all duration-300 transform rounded-lg
              <%= activePage === 'refer' ? activeClass : inactiveClass %>">
          Refer & Earn
        </a>

      </nav>

      <form action="/logout" method="POST" id="logoutFormDesktop">
        <button type="button"
                class="text-red-600 px-4 py-3 transition-all duration-300 transform hover:translate-x-2 hover:bg-white rounded-lg hover:shadow-md tracking-widest logoutBtn">
          Sign Out
        </button>
      </form>
    </nav>

  </div>

</div>