<footer class="bg-[#121212] text-[#FAFAF8]">

  <!-- Top Section -->
  <div class="max-w-7xl mx-auto px-6 py-16">

    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 text-center md:text-left">

      <!-- Logo Column -->
      <div>
        <a href="/" class="inline-block">
          <span class="relative inline-block text-2xl md:text-3xl font-semibold font-[Playfair_Display] tracking-tight">
            BooksKart
            <!-- <span class="absolute left-0 -bottom-1 w-full h-[1px] bg-[#FAFAF8]"></span> -->
          </span>
        </a>
      </div>

      <!-- Shop -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide mb-4">
          Shop
        </h3>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="/shop?sort=new"
               class="hover:underline transition">
              New Arrivals
            </a>
          </li>
          <!-- <li>
            <a href="/shop?sort=best"
               class="hover:underline transition">
              Best Sellers
            </a>
          </li> -->
        </ul>
      </div>

      <!-- Category -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide mb-4">
          Category
        </h3>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="/shop?category=fiction"
               class="hover:underline transition">
              Fiction
            </a>
          </li>
          <li>
            <a href="/shop?category=self-help"
               class="hover:underline transition">
              Self-Help
            </a>
          </li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide mb-4">
          Company
        </h3>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="/privacy-policy"
               class="hover:underline transition">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/about"
               class="hover:underline transition">
              About Us
            </a>
          </li>
        </ul>
      </div>

    </div>
  </div>

  <!-- Divider -->
  <div class="border-t border-[#FAFAF8]/20"></div>

  <!-- Bottom Section -->
  <div class="max-w-7xl mx-auto px-6 py-6 flex flex-col md:flex-row items-center justify-between gap-6 text-sm text-center md:text-left">

    <!-- Copyright -->
    <p>
      © <%= new Date().getFullYear() %> BooksKart • All Rights Reserved.
    </p>

    <!-- Social Icons -->
    <div class="flex items-center gap-6">

      <!-- Facebook -->
      <a href="https://www.facebook.com/" aria-label="Facebook" class="hover:opacity-70 transition">
        <svg xmlns="http://www.w3.org/2000/svg"
             class="w-5 h-5"
             fill="currentColor"
             viewBox="0 0 24 24">
          <path d="M22 12.07C22 6.48 17.52 2 11.93 2S2 6.48 2 12.07c0 5.01 3.66 9.17 8.44 9.93v-7.03H7.9v-2.9h2.54V9.41c0-2.5 1.49-3.88 3.77-3.88 1.09 0 2.23.19 2.23.19v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.77l-.44 2.9h-2.33V22c4.78-.76 8.44-4.92 8.44-9.93z"/>
        </svg>
