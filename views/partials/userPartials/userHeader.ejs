<header class="bg-[#FAFAF8] border-b border-gray-200 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between relative">

    <!-- Logo -->
    <a href="/" class="z-20">
        <span class="text-2xl md:text-3xl font-semibold tracking-tight">
            <span class="font-[Playfair_Display]">BooksKart</span>
        </span>
    </a>



    <!-- Desktop Navigation -->
    <nav class="absolute left-1/2 -translate-x-1/2 hidden md:flex gap-10 text-sm font-medium tracking-wide">
      <a href="/" class="group">
        <span class="inline-block transition-transform duration-300 group-hover:scale-110">
          HOME
        </span>
      </a>
      <a href="/shop" class="group">
        <span class="inline-block transition-transform duration-300 group-hover:scale-110">
          SHOP
        </span>
      </a>
    </nav>

    <!-- Right Section -->
    <div class="hidden md:flex items-center gap-8">

      <% if (headerType === "main") { %>

        <!-- Cart -->
        <a href="/cart" class="group relative">
        
          <span class="inline-block transition-transform duration-300 group-hover:scale-110">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"
              stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="20" r="1.2"></circle>
              <circle cx="17" cy="20" r="1.2"></circle>
              <path d="M3 4h2l2.5 11h11.5l2-8H7.5"></path>
            </svg>
          </span>
        
          <!-- 🔴 BADGE -->
          <span id="cartCount"
            class="absolute -top-2 -right-2 bg-red-500 text-white text-[10px] px-1.5 py-[1px] rounded-full min-w-[16px] text-center hidden">
            0
          </span>
        
        </a>

        <!-- Wishlist -->
        <a href="/wishlist" class="group">
          <span class="inline-block transition-transform duration-300 group-hover:scale-110">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none"
            viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M4.318 6.318a4.5 4.5 0 016.364 0L12 7.636l1.318-1.318a4.5 4.5 0 116.364 6.364L12 20.364 4.318 12.682a4.5 4.5 0 010-6.364z" />
          </svg>
          </span>
        </a>

        <!-- Profile -->
        <a href="/profile" class="group">
          <span class="inline-block transition-transform duration-300 group-hover:scale-110">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none"
            viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"
            stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="3.2"></circle>
            <path d="M4 20
                     c0-3.5 3.5-5.5 8-5.5
                     s8 2 8 5.5">
            </path>
          </svg>
          </span>
        </a>

      <% } else if (headerType === "landing") { %>

        <a href="/login"
           class="bg-[#121212] text-white rounded-lg px-6 py-2 text-sm font-medium group">
           <span class="inline-block transition-transform duration-300 group-hover:scale-110">
            Log in
           </span>
        </a>

      <% } %>

    </div>

    <!-- Mobile Menu Button -->
    <button id="mobileMenuBtn"
      class="md:hidden z-20 group">
      <span class="inline-block transition-transform duration-300 group-hover:scale-110">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7"
        fill="none" viewBox="0 0 24 24"
        stroke="currentColor" stroke-width="1.7">
        <path stroke-linecap="round" stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      </span>
    </button>

  </div>

  <!-- Mobile Menu -->
  <div id="mobileMenu"
     class="hidden md:hidden border-t border-gray-200 bg-[#FAFAF8] transition-all duration-300">

  <div class="px-6 py-6 flex flex-col items-center gap-6 text-sm font-medium">

    <a href="/" class="group">
        <span class="inline-block transition-transform duration-300 group-hover:scale-110">
          HOME
        </span>
      </a>
      <a href="/shop" class="group">
        <span class="inline-block transition-transform duration-300 group-hover:scale-110">
          SHOP
        </span>
      </a>

    <% if (headerType === "main") { %>

      <div class="flex gap-10 mt-4">

        <a href="/cart" class="group">
          <svg xmlns="http://www.w3.org/2000/svg"
            class="w-7 h-7 transition-all duration-200 group-hover:scale-110 group-hover:text-[#333333]"
            fill="none" viewBox="0 0 24 24"
            stroke="currentColor" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="20" r="1.2"></circle>
            <circle cx="17" cy="20" r="1.2"></circle>
            <path d="M3 4h2l2.5 11h11.5l2-8H7.5"></path>
          </svg>
        </a>

        <a href="/wishlist" class="group">
          <svg xmlns="http://www.w3.org/2000/svg"
            class="w-7 h-7 transition-all duration-200 group-hover:scale-110 group-hover:text-[#333333]"
            fill="none" viewBox="0 0 24 24"
            stroke="currentColor" stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M4.318 6.318a4.5 4.5 0 016.364 0L12 7.636l1.318-1.318a4.5 4.5 0 116.364 6.364L12 20.364 4.318 12.682a4.5 4.5 0 010-6.364z" />
          </svg>
        </a>

        <a href="/profile" class="group">
          <svg xmlns="http://www.w3.org/2000/svg"
            class="w-7 h-7 transition-all duration-200 group-hover:scale-110 group-hover:text-[#333333]"
            fill="none" viewBox="0 0 24 24"
            stroke="currentColor" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="3.2"></circle>
            <path d="M4 20
                     c0-3.5 3.5-5.5 8-5.5
                     s8 2 8 5.5">
            </path>
          </svg>
        </a>

      </div>

    <% } else if (headerType === "landing") { %>

      <a href="/login"
           class="bg-[#121212] text-white rounded-lg px-6 py-2 text-sm font-medium group">
           <span class="inline-block transition-transform duration-300 group-hover:scale-110">
            Log in
           </span>
        </a>

    <% } %>

  </div>
</div>

</header>
