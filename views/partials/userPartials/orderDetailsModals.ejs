<!-- ================= OVERLAY ================= -->
<div id="modalOverlay"
     class="fixed inset-0 bg-black/40 hidden z-40"></div>


<!-- ================= CANCEL ITEM MODAL ================= -->
<div id="cancelItemModal"
     class="fixed inset-0 hidden items-center justify-center z-50">

  <div class="bg-[#FAFAF8] p-6 rounded-lg w-full max-w-md space-y-4">

    <h2 class="text-lg font-semibold">Cancel Item</h2>

    <textarea id="cancelItemReason"
      class="w-full border border-[#121212] rounded-md p-3 text-sm focus:outline-none"
      placeholder="Reason (required)"></textarea>

    <p id="cancelItemError" class="text-red-500 text-sm"></p>      

    <div class="flex justify-end gap-4">
      <button class="text-sm hover:underline closeModal">Cancel</button>

      <button id="confirmCancelItem"
        class="bg-[#121212] text-white px-4 py-2 rounded-md">
        Confirm
      </button>
    </div>

  </div>
</div>


<!-- ================= RETURN ITEM MODAL ================= -->
