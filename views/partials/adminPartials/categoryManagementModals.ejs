name="name"
id="editCategoryName"
class="w-full border border-gray-300 rounded-md px-3 py-2
focus:outline-none focus:border-[#333333]"
/>

<p class="text-xs text-red-600 mt-1 hidden" id="editCategoryNameError"></p>

</div>



<!-- Description -->
<div class="mb-5">

<label class="text-sm mb-2 block">Description</label>

<textarea
name="description"
id="editCategoryDescription"
rows="4"
class="w-full border border-gray-300 rounded-md px-3 py-2
focus:outline-none focus:border-[#333333]"></textarea>

<p class="text-xs text-red-600 mt-1 hidden" id="editCategoryDescriptionError"></p>

</div>



<!-- Status -->
<div class="flex items-center justify-between mb-6">

<div>
<p class="text-sm">Status</p>
