</div>

<label class="relative inline-flex items-center cursor-pointer">

<input
type="checkbox"
name="status"
id="editCategoryStatus"
class="sr-only peer"
/>

<div
class="w-10 h-5 bg-gray-300 rounded-full peer
peer-checked:bg-[#121212]
after:content-['']
after:absolute after:top-[2px] after:left-[2px]
after:bg-white after:border after:rounded-full
after:h-4 after:w-4 after:transition-all
peer-checked:after:translate-x-5">
</div>

</label>

</div>



<hr class="my-6">



<!-- Actions -->
<div class="flex items-center justify-between">

<button
type="submit"
class="bg-[#121212] text-[#FAFAF8] px-6 py-2 rounded-md text-sm
hover:opacity-90">
Save Changes
</button>

<button
type="button"
class="closeCategoryModal border border-gray-300 px-5 py-2 rounded-md text-sm hover:bg-gray-100">
Cancel
</button>

</div>

</form>

</div>

</div>



