<!-- OVERLAY -->
<div id="categoryModalOverlay"
class="fixed inset-0 bg-black bg-opacity-30 hidden z-40"></div>



<!-- ========================================================= -->
<!-- ADD CATEGORY MODAL -->
<!-- ========================================================= -->

<div id="addCategoryModal"
class="fixed inset-0 flex items-center justify-center hidden z-50 px-4">

<div class="bg-[#FAFAF8] w-full max-w-md border border-gray-300 rounded-lg p-8">

<h2 class="text-lg font-medium mb-6">Add Category</h2>

<form id="addCategoryForm" method="POST" action="/admin/categories">

<!-- Name -->
<div class="mb-5">

<label class="text-sm mb-2 block">Category Name</label>

<input
type="text"
name="name"
class="w-full border border-gray-300 rounded-md px-3 py-2
focus:outline-none focus:border-[#333333]"
/>

<p class="text-xs text-red-600 mt-1 hidden" id="addCategoryNameError"></p>

</div>


<!-- Description -->
<div class="mb-5">

<label class="text-sm mb-2 block">Description</label>

<textarea
name="description"
rows="4"
class="w-full border border-gray-300 rounded-md px-3 py-2
focus:outline-none focus:border-[#333333]"></textarea>

<p class="text-xs text-red-600 mt-1 hidden" id="addCategoryDescriptionError"></p>

</div>



<!-- Status -->
<div class="flex items-center justify-between mb-6">

<div>
<p class="text-sm">Status</p>
<p class="text-xs opacity-70">Active</p>
</div>

<label class="relative inline-flex items-center cursor-pointer">

<input
type="checkbox"
name="status"
checked
class="sr-only peer"
/>

<div
class="w-10 h-5 bg-gray-300 rounded-full peer
peer-checked:bg-[#121212]
after:content-['']
after:absolute after:top-[2px] after:left-[2px]
after:bg-white after:border after:rounded-full
after:h-4 after:w-4 after:transition-all
peer-checked:after:translate-x-5">
</div>

</label>

</div>



<hr class="my-6">



<!-- Actions -->
<div class="flex items-center justify-between">

<button
type="submit"
class="bg-[#121212] text-[#FAFAF8] px-6 py-2 rounded-md text-sm
hover:opacity-90">
Save
</button>

<button
type="button"
class="closeCategoryModal border border-gray-300 px-5 py-2 rounded-md text-sm hover:bg-gray-100">
Cancel
</button>

</div>

</form>

</div>

</div>



<!-- ========================================================= -->
<!-- EDIT CATEGORY MODAL -->
