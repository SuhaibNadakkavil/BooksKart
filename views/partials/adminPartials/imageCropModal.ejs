<div id="cropModal" class="fixed inset-0 bg-black/60 hidden items-center justify-center z-50">

  <div class="bg-white p-4 rounded w-[90%] max-w-xl">

    <h2 class="text-sm font-medium mb-2">Crop Image</h2>

    <div class="w-full h-[400px] overflow-hidden">
    <img id="cropImage" class="block max-w-full" />
    </div>

    <div class="flex justify-end gap-4 mt-4">

      <button id="cancelCrop" class="text-sm hover:underline">Cancel</button>

      <button id="confirmCrop"
        class="px-4 py-2 bg-[#121212] text-white rounded">
        Crop & Save
      </button>

    </div>

  </div>

</div>