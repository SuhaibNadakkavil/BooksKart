<!-- Desktop Sidebar -->

<aside class="hidden lg:block w-64 shrink-0 border-r border-gray-200">

  <div class="p-8 space-y-10">

    <p class="text-2xl md:text-3xl font-semibold font-[Playfair_Display] tracking-wide">
      BooksKart
    </p>

    <nav class="flex flex-col gap-2 text-[16px] tracking-widest">

      <% 
        const activeClass='bg-gray-200 border-l-4 shadow-md hover:translate-x-2' ; 
        const inactiveClass='hover:translate-x-2 hover:bg-white hover:shadow-md' ; 
      %>

      <a href="/admin/dashboard" class="px-4 py-3 transition-all duration-300 transform rounded-lg
      <%= activePage === 'dashboard' ? activeClass : inactiveClass %>">
        Dashboard
      </a>

      <a href="/admin/orders" class="px-4 py-3 transition-all duration-300 transform rounded-lg
      <%= activePage === 'orders' ? activeClass : inactiveClass %>">
        Orders
      </a>

      <a href="/admin/products" class="px-4 py-3 rounded-lg transition-all duration-300
        <%= activePage === 'products' ? activeClass : inactiveClass %>">
        Products
      </a>

      <a href="/admin/users" class="px-4 py-3 transition-all duration-300 transform rounded-lg
      <%= activePage === 'users' ? activeClass : inactiveClass %>">
        Customers
      </a>

      <a href="/admin/sales-report" class="px-4 py-3 transition-all duration-300 transform rounded-lg
      <%= activePage === 'sales-report' ? activeClass : inactiveClass %>">
        Sales Report
      </a>

      <a href="/admin/coupons" class="px-4 py-3 transition-all duration-300 transform rounded-lg
      <%= activePage === 'coupons' ? activeClass : inactiveClass %>">
        Coupons
      </a>

      <a href="/admin/categories" class="px-4 py-3 transition-all duration-300 transform rounded-lg
      <%= activePage === 'categories' ? activeClass : inactiveClass %>">
        Category
      </a>

      <form action="/admin/logout" method="POST" id="adminLogoutForm">
        <button
          type="button"
          id="adminLogoutBtn"
          class="text-red-600 px-4 py-3 transition-all duration-300 transform hover:translate-x-2 hover:bg-white rounded-lg hover:shadow-md tracking-widest">
          Sign Out
        </button>
      </form>

    </nav>

  </div>

</aside>



<!-- Mobile Drawer -->

<div id="adminSidebar"
     class="fixed inset-0 z-50 hidden lg:hidden">

  <!-- Overlay -->

  <div id="adminSidebarOverlay"
       class="absolute inset-0 bg-black bg-opacity-30 opacity-0 transition-opacity duration-300">
  </div>


  <!-- Drawer -->

  <div id="adminSidebarPanel"
       class="absolute left-0 top-0 h-full w-72 bg-[#FAFAF8] p-8
              transform -translate-x-full transition-transform duration-300">

    <div class="flex justify-between items-center mb-5">

      <p class="text-2xl md:text-3xl font-semibold font-[Playfair_Display]">
        BooksKart
      </p>

      <button id="closeAdminSidebar" class="text-[18px]">
        ✕
      </button>

    </div>


    <nav class="flex flex-col gap-1 text-[16px] tracking-widest">

      <a href="/admin/dashboard" class="px-4 py-3 transition-all duration-300 transform rounded-lg
      <%= activePage === 'dashboard' ? activeClass : inactiveClass %>">
        Dashboard
      </a>

      <a href="/admin/orders" class="px-4 py-3 transition-all duration-300 transform rounded-lg
      <%= activePage === 'orders' ? activeClass : inactiveClass %>">
        Orders
      </a>

      <a href="/admin/products" class="px-4 py-3 rounded-lg transition-all duration-300
        <%= activePage === 'products' ? activeClass : inactiveClass %>">
        Products
      </a>

      <a href="/admin/users" class="px-4 py-3 transition-all duration-300 transform rounded-lg
      <%= activePage === 'users' ? activeClass : inactiveClass %>">
        Customers
      </a>

      <a href="/admin/sales-report" class="px-4 py-3 transition-all duration-300 transform rounded-lg
      <%= activePage === 'sales-report' ? activeClass : inactiveClass %>">
        Sales Report
      </a>

      <a href="/admin/coupons" class="px-4 py-3 transition-all duration-300 transform rounded-lg
      <%= activePage === 'coupons' ? activeClass : inactiveClass %>">
        Coupons
      </a>

      <a href="/admin/categories" class="px-4 py-3 transition-all duration-300 transform rounded-lg
      <%= activePage === 'categories' ? activeClass : inactiveClass %>">
        Category
      </a>

      <form action="/admin/logout" method="POST" id="adminLogoutForm">
        <button
          type="button"
          id="adminLogoutBtn"
          class="text-red-600 px-4 py-3 transition-all duration-300 transform hover:translate-x-2 hover:bg-white rounded-lg hover:shadow-md tracking-widest">
          Sign Out
        </button>
      </form>

    </nav>

  </div>

</div>