<section class="min-h-screen flex items-center justify-center bg-[#FAFAF8] px-4">

  <div class="w-full max-w-md border border-[#121212] rounded-3xl p-10">

    <!-- Heading -->
    <div class="text-center mb-8">
      <h1 class="text-3xl font-semibold text-[#121212]">
        <% if (mode === "reset") { %>
          Verify OTP
        <% } else if (mode === "change-email") { %>
          Verify New Email
        <% } else { %>
          Verify Your Email
        <% } %>
      </h1>

      <p class="text-sm mt-2 opacity-80 leading-relaxed">
        <% if (mode === "reset") { %>
          Enter the 6-digit OTP sent to your email to reset your password.
        <% } else if (mode === "change-email") { %>
          Enter the 6-digit code sent to your new email address to confirm the change.
        <% } else { %>
          Enter the 6-digit code sent to your email to complete verification.
        <% } %>
      </p>
    </div>

    <!-- OTP Form -->
    <form
      id="otpForm"
      action="<%= mode === 'reset' ? '/verify-reset-otp' : '/verify-otp' %>"
      method="POST"
      class="flex flex-col items-center"
    >

      <input type="hidden" name="email" value="<%= email || '' %>" />
      <input type="hidden" name="mode" value="<%= mode %>" />

      <!-- OTP Boxes -->
      <div class="flex justify-center gap-4 mb-8">

        <% for(let i = 0; i < 6; i++) { %>
          <input
            type="text"
            maxlength="1"
            inputmode="numeric"
            class="otp-input w-14 h-14 text-xl text-center border border-[#121212] rounded-xl focus:outline-none focus:border-[#333333] transition hover:border-[#333333]"
          />
        <% } %>

      </div>

      <input type="hidden" name="otp" id="combinedOtp" />

      <!-- Button -->
      <button
        type="submit"
        id="verifyBtn"
        class="w-full bg-[#121212] text-[#FAFAF8] py-3 rounded-xl font-medium transition hover:opacity-90 disabled:opacity-60"
      >
        <% if (mode === "reset") { %>
          Verify OTP
        <% } else if (mode === "change-email") { %>
          Verify Email
        <% } else { %>
          Verify Email
        <% } %>
      </button>

      <!-- Resend -->
      <div class="text-center text-sm mt-6">
        <span>Didn't receive the code?</span>
        <button
          type="button"
          id="resendBtn"
          class="text-blue-700 relative group ml-1 opacity-50 cursor-not-allowed"
          disabled
          data-mode="<%= mode %>"
        >
          Resend Code in <span id="timer">59</span>s
          <span class="absolute left-0 -bottom-1 w-0 h-[1px] bg-blue-700 transition-all duration-300 group-hover:w-full"></span>
        </button>
      </div>

    </form>

  </div>

</section>