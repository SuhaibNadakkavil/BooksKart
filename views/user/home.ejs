<!-- New Arrivals -->
<section class="bg-[#FAFAF8] py-20">

  <div class="max-w-7xl mx-auto px-6">

    <div class="text-center mb-14">
      <h2 class="text-sm tracking-widest uppercase font-semibold text-[#121212]">
        New Arrivals
      </h2>
      <div class="w-24 h-[1px] bg-[#121212] mx-auto mt-4"></div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-10">
    
      <% newArrivals.forEach(product=> { %>
    
        <a href="/product/<%= product.slug %>" class="group space-y-4">
    
          <div class="overflow-hidden aspect-[3/4]">
            <img src="<%= product.images.cover %>"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              alt="<%= product.title %>">
          </div>
    
          <div class="space-y-1">
            <h3 class="text-sm font-medium group-hover:underline">
              <%= product.title %>
            </h3>
    
            <p class="text-xs opacity-70">
              <%= product.author %>
            </p>
    
            <p class="text-sm font-semibold">
              ₹<%= product.variants[0].salePrice %>
            </p>
          </div>
    
        </a>
    
        <% }) %>
    
    </div>

  </div>

</section>

