<section class="bg-[#FAFAF8] min-h-screen flex items-center">

  <div class="max-w-7xl mx-auto px-6 w-full">

    <div class="grid grid-cols-1 md:grid-cols-2 items-center gap-16">

      <!-- LEFT CONTENT -->
      <div class="space-y-10 text-center md:text-left">

        <!-- Heading -->
        <div>
          <h1 class="font-[Playfair_Display] text-5xl sm:text-6xl md:text-7xl leading-tight text-[#121212]">
            Read.<br>
            Dream.<br>
            Grow.
          </h1>
        </div>

        <!-- Divider -->
        <div class="w-16 h-[2px] bg-[#121212] mx-auto md:mx-0"></div>

        <!-- Subtext -->
        <p class="text-sm tracking-widest uppercase text-[#121212]">
          Curated literature for the modern mind
        </p>

        <!-- CTA -->
        <div>
          <a href="/shop"
             class="inline-flex items-center gap-3 text-[#121212] text-sm font-medium group">

            <span class="relative">
              Start Your Journey
              <span class="absolute left-0 -bottom-1 w-0 h-[1px] bg-[#121212] transition-all duration-300 group-hover:w-full"></span>
            </span>

            <span class="transform transition-transform duration-300 group-hover:translate-x-2">
              →
            </span>
          </a>
        </div>

      </div>

      <!-- RIGHT IMAGE -->
      <div class="relative overflow-hidden">

        <img src="/images/hero-books.jpeg"
             alt="Bookshelf"
             class="w-full h-[450px] sm:h-[550px] md:h-[650px] object-cover transition-transform duration-500 hover:scale-105" />

      </div>

    </div>

  </div>

</section>

<!-- Browse Categories -->
<section class="bg-[#FAFAF8] py-20">

  <div class="max-w-7xl mx-auto px-6">

    <!-- Section Title -->
    <div class="text-center mb-14">
      <h2 class="text-sm tracking-widest uppercase font-semibold text-[#121212]">
        Browse Categories
      </h2>
      <div class="w-24 h-[1px] bg-[#121212] mx-auto mt-4"></div>
    </div>

    <!-- Category Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

      <!-- Fiction -->
      <a href="/shop?category=fiction"
         class="group relative overflow-hidden">

        <img src="/images/category-fiction.jpeg"
             class="w-full h-[320px] object-cover transition-transform duration-500 group-hover:scale-105"
             alt="Fiction">

        <div class="absolute inset-0 bg-[#121212]/40 flex flex-col justify-end p-8">
          <h3 class="text-2xl font-semibold text-[#FAFAF8] font-[Playfair_Display]">
            Fiction
          </h3>
          <p class="text-xs tracking-widest uppercase text-[#FAFAF8] mt-2">
            Explore the imagined
          </p>
        </div>

      </a>

      <!-- Self Help -->
      <a href="/shop?category=self-help"
         class="group relative overflow-hidden">

        <img src="/images/category-self-help.jpeg"
             class="w-full h-[320px] object-cover transition-transform duration-500 group-hover:scale-105"
             alt="Self Help">

        <div class="absolute inset-0 bg-[#121212]/40 flex flex-col justify-end p-8">
          <h3 class="text-2xl font-semibold text-[#FAFAF8] font-[Playfair_Display]">
            Self-Help
          </h3>
          <p class="text-xs tracking-widest uppercase text-[#FAFAF8] mt-2">
            Personal evolution
          </p>
        </div>

      </a>

    </div>

  </div>

</section>


