<div class="flex gap-10">

  <!-- Sidebar -->
  <%- include('../partials/userPartials/sidebar', { activePage: 'orders' }) %>

  <!-- ================= RIGHT CONTENT ================= -->
  <section class="flex-1">

    <!-- Mobile Header -->
    <div class="flex items-center gap-4 mb-8 lg:hidden">
      <button id="sidebarToggle" class="text-[20px] font-semibold">☰</button>
      <h1 class="text-2xl font-semibold">Orders</h1>
    </div>

    <!-- Desktop Header -->
    <div class="hidden lg:block mb-10">
      <h1 class="text-[32px] font-semibold">Orders</h1>
      <p class="text-sm opacity-70 mt-2">
        A historical record of your literary acquisitions and shipments.
      </p>
    </div>


    <!-- ================= SEARCH + FILTER ================= -->
    <form method="GET" action="/orders"
      class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-10">

      <!-- Search -->
      <div class="flex items-center gap-3">

        <input
          type="text"
          name="search"
          value="<%= query?.search || '' %>"
          placeholder="Search orders..."
          class="border border-[#121212] rounded-lg px-4 py-2 w-64 focus:outline-none focus:border-[#333333]"
        />

        <button class="bg-[#121212] text-[#FAFAF8] px-4 py-2 rounded-md group">
          <span class="group-hover:scale-110 inline-block transition">
            Search
          </span>
        </button>

        <% if(query?.search){ %>
          <a href="/orders" class="text-xs underline">CLEAR</a>
        <% } %>

      </div>


      <!-- Filter + Sort -->
      <div class="flex items-center gap-4 text-sm">

        <!-- Status Filter -->
        <select id="statusFilter" name="status"
          class="border border-[#121212] px-3 py-2 rounded-md focus:outline-none">

          <option value="all">All Status</option>

          <option value="pending" <%= query?.status === "pending" ? "selected" : "" %>>
            Pending
          </option>

          <option value="shipped" <%= query?.status === "shipped" ? "selected" : "" %>>
            Shipped
          </option>

          <option value="out_for_delivery" <%=query?.status==="out_for_delivery" ? "selected" : "" %>>
            Out for Delivery
          </option>

          <option value="delivered" <%= query?.status === "delivered" ? "selected" : "" %>>
            Delivered
          </option>

          <option value="cancelled" <%= query?.status === "cancelled" ? "selected" : "" %>>
            Cancelled
          </option>

          <option value="returned" <%=query?.status === "returned" ? "selected" : "" %>>
            Returned
          </option>

        </select>


        <!-- Sort -->
        <select id="sortSelect" name="sort"
          class="border border-[#121212] px-3 py-2 rounded-md focus:outline-none">

          <option value="newest" <%= query?.sort === "newest" ? "selected" : "" %>>
            Newest
          </option>

          <option value="oldest" <%= query?.sort === "oldest" ? "selected" : "" %>>
            Oldest
          </option>

          <option value="price_low" <%= query?.sort === "price_low" ? "selected" : "" %>>
            Price Low → High
          </option>

          <option value="price_high" <%= query?.sort === "price_high" ? "selected" : "" %>>
            Price High → Low
          </option>

        </select>

      </div>

    </form>


    <!-- ================= ORDER LIST ================= -->
    <div class="space-y-8">

      <% if(orders && orders.length > 0){ %>

        <% orders.forEach(order => { %>

          <div class="border-t pt-6">

            <div class="grid grid-cols-1 md:grid-cols-4 gap-6 items-center">

              <!-- Order Ref -->
              <div>
                <p class="text-xs opacity-60 uppercase">Order Reference</p>
                <p class="font-medium">#<%= order.orderId %></p>
                <p class="text-xs opacity-60">
                  <%= new Date(order.createdAt).toDateString() %>
                </p>
              </div>

              <!-- Acquisitions -->
              <div>
                <p class="text-xs opacity-60 uppercase">Items</p>
                <p class="font-medium">
                  <%= order.acquisitions %>
                </p>
              </div>

              <!-- Status -->
              <div>
                <p class="text-xs opacity-60 uppercase">Status</p>
                <p class="italic">
                  <%= order.orderStatus.replaceAll("_", " " ).replace(/\b\w/g, c=> c.toUpperCase()) %>
                </p>
              </div>

              <!-- Total + Actions -->
              <div class="text-right space-y-2">

                <p class="font-semibold">₹<%= order.totalAmount %></p>

                <div class="flex justify-end gap-4 text-xs">

                  <a href="/orders/<%= order.orderId %>"
                     class="border rounded-md px-1 py-0.5 text-black hover:bg-black hover:text-white transition">
                    View Details
                  </a>

                  <a href="/orders/<%= order.orderId %>/invoice"
                     class="border rounded-md px-1 py-0.5 text-black hover:bg-black hover:text-white transition">
                    Invoice
                  </a>

                </div>

              </div>

            </div>

          </div>

        <% }) %>

      <% } else { %>

        <div class="text-center py-20 opacity-70">
          No orders found
        </div>

      <% } %>

    </div>


    <!-- ================= PAGINATION ================= -->
    <div class="flex flex-col md:flex-row md:justify-between items-center mt-10 text-sm">

      <p class="opacity-70 mb-4 md:mb-0">
        Showing <%= orders.length %> of <%= totalOrders %> orders
      </p>

      <div class="flex items-center gap-4">

        <% if(page > 1){ %>
          <a href="?search=<%= query.search || '' %>&status=<%= query.status || '' %>&sort=<%= query.sort || '' %>&page=<%= page - 1 %>"
             class="hover:underline">
            ← Previous
          </a>
        <% } %>

        <div class="flex gap-2">

          <% for(let i = 1; i <= totalPages; i++){ %>
            <a href="?search=<%= query.search || '' %>&status=<%= query.status || '' %>&sort=<%= query.sort || '' %>&page=<%= i %>"
              class="<%= page === i ? 'font-semibold underline' : 'hover:underline' %> px-2">
              <%= i %>
            </a>
          <% } %>

        </div>

        <% if(page < totalPages){ %>
          <a href="?search=<%= query.search || '' %>&status=<%= query.status || '' %>&sort=<%= query.sort || '' %>&page=<%= page + 1 %>"
             class="hover:underline">
            Next →
          </a>
        <% } %>

      </div>

    </div>

  </section>

</div>