<section class="max-w-6xl mx-auto">

  <!-- HEADER -->
  <h1 class="text-3xl md:text-4xl font-semibold mb-10 text-center">
    Your Cart
  </h1>

  <!-- ✅ CART CONTAINER -->
  <div id="cartContainer" class="<%= (!cartItems || cartItems.length === 0) ? 'hidden' : '' %>">

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">

    <!-- LEFT: CART ITEMS -->
    <div class="lg:col-span-2 space-y-8">

      <% cartItems.forEach(item => { 
           const variant = item.selectedVariant;
      %>

    <div class="cart-item rounded-lg bg-white hover:shadow-xl p-6 flex gap-6 items-start"
        data-product="<%= item.productId %>" data-variant="<%= variant?.type %>"
        data-price="<%= variant.salePrice || variant.regularPrice %>"
        data-stock="<%= variant.stock %>"
        data-outofstock="<%= item.isOutOfStock %>"
        data-unavailable="<%= item.isUnavailable %>"
        >

        <!-- IMAGE -->
        <a href="/product/<%= item.slug %>" class="w-24">
          <img src="<%= item.images.cover %>"
            class="w-full h-auto object-cover rounded-lg">
        </a>

        <!-- DETAILS -->
        <div class="flex-1">

          <h3 class="text-lg font-semibold">
            <%= item.title %>
          </h3>

          <p class="text-sm text-[#121212]/70">
            <%= item.author %>
          </p>

          <!-- VARIANT -->
          <p class="text-xs mt-1 uppercase tracking-wide text-[#121212]/60">
            <%= variant?.type || "N/A" %>
          </p>

          <!-- QUANTITY -->
          <div class="mt-4 flex items-center gap-3">

            <% if (item.isOutOfStock) { %>

              <button disabled class="px-4 py-1 bg-red-600 text-white rounded-lg cursor-not-allowed">
                Out of Stock
              </button>

            <% } else if (item.isUnavailable) { %>

              <button disabled class="px-4 py-1 bg-red-600 text-white rounded-lg cursor-not-allowed">
                Unavailable
              </button>

            <% } else { %>

            <button
              data-product="<%= item.productId %>"
              data-variant="<%= variant?.type %>"
              class="qty-decrease border rounded-lg px-3 py-1 hover:bg-black hover:text-white
              <%= item.quantity <= 1 ? 'opacity-40 cursor-not-allowed' : '' %>"
              <%= item.quantity <= 1 ? 'disabled' : '' %>>
              -
            </button>

            <span class="px-3 qty-value"><%= item.quantity %></span>

            <button
              data-product="<%= item.productId %>"
              data-variant="<%= variant?.type %>"
              class="qty-increase border px-3 py-1 rounded-lg hover:bg-black hover:text-white <%= (item.stockReached || item.maxReached) ? 'opacity-40 cursor-not-allowed': '' %>"
              <%= (item.stockReached || item.maxReached) ? 'disabled': '' %>>
              +
            </button>

            <% } %>

          </div>

        </div>

        <!-- RIGHT SIDE -->
        <div class="text-right space-y-4">

          <!-- PRICE -->
          <% if (variant && variant.salePrice !== variant.regularPrice) { %>

            <div>
              <p class="text-lg font-semibold text-red-600">
                ₹<%= variant.salePrice %>
              </p>
              <p class="text-sm line-through text-[#121212]/50">
                ₹<%= variant.regularPrice %>
              </p>
            </div>

          <% } else { %>

            <p class="text-lg font-semibold">
              ₹<%= variant?.regularPrice || 0 %>
            </p>

          <% } %>

          <!-- REMOVE -->
          <button
            data-product="<%= item.productId %>"
            data-variant="<%= variant?.type %>"
            class="removeCartBtn text-sm border text-red-600 px-2 py-1.5 rounded-md hover:bg-red-600 hover:text-white">
            REMOVE
          </button>

        </div>

      </div>

      <% }) %>

    </div>


    <!-- RIGHT: SUMMARY -->
    <div class="rounded-xl p-6 h-fit hover:shadow-xl bg-white">

      <h2 class="text-xl font-semibold mb-6">
        Order Summary
      </h2>

      <div class="space-y-4 text-sm">

        <div class="flex justify-between">
          <span>Subtotal</span>
          <span id="subtotal">₹<%= subtotal %></span>
        </div>

        <div class="flex justify-between">
          <span>Quantity</span>
          <span id="totalItems"><%= totalItems %></span>
        </div>

      </div>

      <div class="border-t mt-6 pt-6 flex justify-between items-center">

        <span class="font-semibold">TOTAL</span>
        <span id="totalAmount" class="text-2xl font-semibold">₹<%= subtotal %></span>

      </div>

      <button
        id="checkoutBtn"
        class="group w-full mt-6 py-3 bg-[#121212] text-[#FAFAF8] rounded-md
        <%= hasInvalidItems ? 'cursor-not-allowed' : '' %>"
        <%= hasInvalidItems ? 'disabled' : '' %>>
        <span class="inline-block transition-transform duration-300 group-hover:scale-110">
          PROCEED TO CHECKOUT
        </span>
      </button>

    </div>

  </div>
  </div>

  <!-- ✅ EMPTY STATE -->
  <div id="emptyState" class="<%= (cartItems && cartItems.length > 0) ? 'hidden' : '' %>">

  <section class="relative min-h-[60vh] flex items-center justify-center">

    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <span class="text-[140px] md:text-[220px] font-semibold text-[#121212]/20">
        🛒
      </span>
    </div>

    <div class="relative z-10 text-center max-w-xl">

      <h2 class="text-2xl font-semibold">
        Your cart is empty
      </h2>

      <p class="mt-4 text-[#121212]/70">
        Looks like you haven’t added anything yet.
      </p>

    <div class="mt-8">
        <a href="/shop"
            class="group px-8 py-3 bg-[#121212] text-[#FAFAF8] rounded-md">
            <span class="inline-block transition-transform duration-300 group-hover:scale-110">
                Browse Books
            </span>
        </a>
    </div>



    </div>

  </section>

  </div>

</section>