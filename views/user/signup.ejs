<section class="min-h-[80vh] flex items-center justify-center px-4">

  <div class="w-full max-w-md border border-[#121212] rounded-2xl bg-[#FAFAF8] p-8">

    <!-- Heading -->
    <div class="text-center mb-6">
      <h1 class="text-2xl font-semibold">Create Your Account</h1>
      <p class="text-sm mt-2">
        Join us and find your perfect books.
      </p>
    </div>

    <!-- Google Signup -->
    <a
      href="/auth/google"
      class="w-full border border-[#121212] rounded-xl py-3 flex items-center justify-center gap-3 text-sm font-medium transition hover:border-[#333333] hover:text-[#333333]">
      <!-- Google Logo SVG -->
      <svg width="18" height="18" viewBox="0 0 48 48">
        <path fill="#EA4335" d="M24 9.5c3.54 0 6.72 1.22 9.23 3.6l6.9-6.9C35.64 2.16 30.17 0 24 0 14.82 0 6.94 5.6 3.4 13.72l8.06 6.26C13.38 13.13 18.2 9.5 24 9.5z"/>
        <path fill="#4285F4" d="M46.14 24.5c0-1.63-.15-3.2-.43-4.7H24v9h12.4c-.53 2.86-2.1 5.28-4.47 6.9l6.9 5.36C43.92 36.63 46.14 30.99 46.14 24.5z"/>
        <path fill="#FBBC05" d="M11.46 28.26A14.5 14.5 0 019.5 24c0-1.48.26-2.9.72-4.22L2.16 13.52A23.96 23.96 0 000 24c0 3.86.92 7.51 2.55 10.72l8.91-6.46z"/>
        <path fill="#34A853" d="M24 48c6.17 0 11.64-2.04 15.52-5.56l-6.9-5.36c-2 1.34-4.54 2.14-8.62 2.14-5.8 0-10.62-3.63-12.54-8.48l-8.91 6.46C6.94 42.4 14.82 48 24 48z"/>
      </svg>
      Signup with Google
    </a>

    <!-- Divider -->
    <div class="flex items-center my-6">
      <div class="flex-1 border-t bg-[#121212]"></div>
      <span class="px-3 text-sm">or</span>
      <div class="flex-1 border-t bg-[#121212]"></div>
    </div>

    <!-- Signup Form -->
    <form id="signupForm" action="/signup" method="POST" novalidate>

      <!-- Name -->
      <div class="mb-4">
        <label class="block text-sm font-medium mb-1">Name</label>
        <input
          type="text"
          name="name"
          id="name"
          value="<%= old?.name || '' %>"
          placeholder="Enter your name"
          class="w-full border border-[#121212] rounded-xl px-4 py-3 outline-none focus:border-[#333333]"
        />
        <p class="text-red-600 text-sm mt-1" id="nameError">
          <%= errors?.name || '' %>
        </p>
      </div>

      <!-- Email -->
      <div class="mb-4">
        <label class="block text-sm font-medium mb-1">Email Address</label>
        <input
          type="email"
          name="email"
          id="email"
          value="<%= old?.email || '' %>"
          placeholder="Enter your email address"
          class="w-full border border-[#121212] rounded-xl px-4 py-3 outline-none focus:border-[#333333]"
        />
        <p class="text-red-600 text-sm mt-1" id="emailError">
          <%= errors?.email || '' %>
        </p>
      </div>

      <!-- Phone -->
      <div class="mb-4">
        <label class="block text-sm font-medium mb-1">Phone Number</label>
        <input
          type="text"
          name="phone"
          id="phone"
          value="<%= old?.phone || '' %>"
          placeholder="Enter your phone number"
          class="w-full border border-[#121212] rounded-xl px-4 py-3 outline-none focus:border-[#333333]"
        />
        <p class="text-red-600 text-sm mt-1" id="phoneError">
          <%= errors?.phone || '' %>
        </p>
      </div>

      <!-- Referral -->
      <div class="mb-4">
        <label class="block text-sm font-medium mb-1">Referral Code</label>
        <input
          type="text"
          name="referralCode"
          id="referralCode"
          value="<%= old?.referralCode || '' %>"
          placeholder="Enter your Referral Code"
          class="w-full border border-[#121212] rounded-xl px-4 py-3 outline-none focus:border-[#333333]"
        />
        <p class="text-red-600 text-sm mt-1" id="referralError">
          <%= errors?.referralCode || '' %>
        </p>
      </div>

      <!-- Password -->
      <div class="mb-4 relative">
        <label class="block text-sm font-medium mb-1">Password</label>
        <input
          type="password"
          name="password"
          id="password"
          placeholder="Create a password"
          class="w-full border border-[#121212] rounded-xl px-4 py-3 outline-none focus:border-[#333333]"
        />
        <button
          type="button"
          data-toggle="password"
          class="absolute right-4 top-10 text-sm"
        >
          👁
        </button>
        <p class="text-red-600 text-sm mt-1" id="passwordError">
          <%= errors?.password || '' %>
        </p>
      </div>

      <!-- Confirm Password -->
      <div class="mb-6 relative">
        <label class="block text-sm font-medium mb-1">Confirm Password</label>
        <input
          type="password"
          name="confirmPassword"
          id="confirmPassword"
          placeholder="Confirm your password"
          class="w-full border border-[#121212] rounded-xl px-4 py-3 outline-none focus:border-[#333333]"
        />
        <button
          type="button"
          data-toggle="confirmPassword"
          class="absolute right-4 top-10 text-sm"
        >
          👁
        </button>
        <p class="text-red-600 text-sm mt-1" id="confirmPasswordError">
          <%= errors?.confirmPassword || '' %>
        </p>
      </div>

      <!-- Submit -->
      <button
        type="submit"
        id="submitBtn"
        class="w-full bg-[#121212] text-white py-3 rounded-xl font-medium transition hover:opacity-90"
      >
        Create Account
      </button>

      <!-- Bottom Link -->
      <p class="text-sm text-center mt-4">
        Already have an account?
        <a href="/login" 
            class="text-blue-700 relative group ml-1">
            Log in
            <span class="absolute left-0 -bottom-1 w-0 h-[1px] bg-blue-700 transition-all duration-300 group-hover:w-full"></span>
        </a>
      </p>

    </form>

  </div>

</section>
