<section class="max-w-xl mx-auto py-8 md:py-14">

  <!-- Card -->
  <div class="bg-white rounded-xl border border-gray-200 px-6 md:px-12 py-10 md:py-14 text-center space-y-10">

    <!-- Top Icon -->
    <div class="flex justify-center">
      <div class="w-16 h-16 rounded-full bg-red-600 flex items-center justify-center">
        <span class="text-3xl font-bold leading-none text-white">!</span>
      </div>
    </div>

    <!-- Heading -->
    <div class="space-y-3">

      <h1 class="text-2xl md:text-3xl font-semibold tracking-tight leading-tight">
        Order Could Not Be Completed
      </h1>

      <p class="text-sm md:text-base tracking-[0.18em] uppercase text-gray-700">
        ORDER ID :
        <span class="font-medium">
          <%= order.orderId %>
        </span>
      </p>

    </div>

    <!-- Divider -->
    <div class="border-t border-gray-200"></div>

    <!-- Instructions -->
    <div class="space-y-8">

      <h2 class="text-sm md:text-xl font-semibold tracking-[0.18em] uppercase">
        What You Can Do Next
      </h2>

      <div class="space-y-6 text-sm md:text-lg leading-relaxed">

        <p>
          1. Verify your billing information and card details.
        </p>

        <p>
          2. Ensure there are sufficient funds in your account.
        </p>

        <p>
          3. Contact your bank to authorize the transaction.
        </p>

        <p>
          4. Try a different payment method.
        </p>

      </div>

    </div>

    <!-- Divider -->
    <div class="border-t border-gray-200"></div>

    <!-- Primary Action -->
    <div class="space-y-6">

      <button
        id="retryPaymentBtn"
        data-order-id="<%= order.orderId %>"
        class="w-full md:w-auto min-w-[320px] bg-[#121212] text-[#FAFAF8] px-10 py-4 rounded-md text-lg font-medium hover:opacity-90 transition"
      >
        Retry Payment
      </button>

      <!-- Secondary Links -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-5 text-lg">

        <a
          href="/checkout"
          class="underline hover:text-[#333333] transition"
        >
          Back to Cart
        </a>

        <a
          href="/shop"
          class="underline hover:text-[#333333] transition"
        >
          Continue Shopping
        </a>

      </div>

    </div>

  </div>

</section>