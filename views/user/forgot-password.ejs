<section class="min-h-screen flex items-center justify-center bg-[#FAFAF8] px-4">

  <div class="w-full max-w-md border border-[#121212] rounded-3xl p-8 sm:p-10">

    <!-- Heading -->
    <div class="text-center mb-8">
      <h1 class="text-3xl sm:text-4xl font-semibold text-[#121212]">
        Forgot Your Password?
      </h1>

      <p class="text-base mt-4 leading-relaxed text-[#121212] opacity-80">
        No problem. Enter your email address below and
        we'll send you an OTP to your email
      </p>
    </div>

    <!-- Form -->
    <form action="/forgot-password" method="POST" novalidate>

      <!-- Email Label -->
      <div class="mb-6">
        <label class="block text-sm font-medium mb-2 text-[#121212]">
          Email Address
        </label>

        <input
          type="email"
          name="email"
          value="<%= old?.email || '' %>"
          placeholder="Enter your email"
          class="w-full border border-[#121212] rounded-xl px-4 py-3 text-base focus:outline-none focus:border-[#333333] transition"
        />

            <!-- Field Error -->
        <p id="emailError" class="text-sm text-red-600 mt-2">
          <%= errors?.email || '' %>
        </p>
      </div>

      <!-- Submit Button -->
      <button
        type="submit"
        id="submitBtn"
        class="w-full bg-[#121212] text-[#FAFAF8] py-3 rounded-xl text-base font-medium transition duration-200 hover:bg-[#333333] disabled:opacity-60 disabled:cursor-not-allowed"
      >
        Send OTP
      </button>


      <!-- Return to Login -->
      <div class="text-center mt-8">
        <a href="/login"
           class=" text-blue-700 relative group ml-1">
          Return to Login
          <span class="absolute left-0 -bottom-1 w-0 h-[1px] bg-blue-700 transition-all duration-300 group-hover:w-full"></span>
        </a>
      </div>

    </form>

  </div>

</section>