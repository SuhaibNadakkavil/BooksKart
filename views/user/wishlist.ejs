<section class="max-w-6xl mx-auto">

  <!-- HEADER -->
  <div class="text-center mb-16">

    <h1 class="text-3xl md:text-4xl font-semibold">
      Your Wishlist
    </h1>

    <p class="mt-3 text-base text-[#121212]/70">
      Books you’ve saved for later.
    </p>

  </div>


  <% if (!wishlistItems || wishlistItems.length === 0) { %>

  <!-- EMPTY STATE -->

  <section class="relative min-h-[60vh] flex items-center justify-center">

    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <span class="text-[140px] md:text-[220px] font-semibold text-[#121212]/10">
        ❤️
      </span>
    </div>

    <div class="relative z-10 text-center max-w-xl">

      <h2 class="text-2xl font-semibold">
        Your wishlist is empty
      </h2>

      <p class="mt-4 text-[#121212]/70">
        Start exploring and save books you love.
      </p>

      <div class="mt-8">

        <a href="/shop"
          class="px-8 py-3 bg-[#121212] text-[#FAFAF8] font-medium rounded-md
                 transition hover:bg-[#333333]">
          Browse Books
        </a>

      </div>

    </div>

  </section>

  <% } else { %>

  <!-- PRODUCT GRID -->

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-12">

    <% wishlistItems.forEach(item => { %>

    <div class="group">

      <!-- IMAGE -->
      <a href="/product/<%= item.slug %>">

        <div class="aspect-[3/4] bg-white flex items-center justify-center">

          <img 
            src="<%= item.images %>"
            class="max-h-full object-contain transition group-hover:opacity-80"
          >

        </div>

      </a>

      <!-- DETAILS -->
      <div class="mt-4 space-y-1">

        <h3 class="text-lg font-semibold">
          <%= item.title %>
        </h3>

        <p class="text-sm text-[#121212]/70">
          <%= item.author %>
        </p>

        <!-- VARIANT + PRICE -->
        <div class="text-sm mt-2">
        
            <span class="uppercase tracking-wide text-[#121212]/60">
                <%= item.variantType %>
            </span>

            <% const variant = item.selectedVariant; %>
        
            <% if (variant && variant.salePrice && variant.salePrice !==variant.regularPrice) { %>
        
                <div class="mt-1 flex items-center gap-2">
        
                    <span class="font-semibold text-red-600">
                        ₹<%= variant.salePrice %>
                    </span>
        
                    <span class="line-through text-[#121212]/50">
                        ₹<%= variant.regularPrice %>
                    </span>
        
                </div>
        
                <% } else if (variant) { %>
        
                    <div class="mt-1 font-semibold">
                        ₹<%= variant.regularPrice %>
                    </div>
        
                    <% } else { %>
        
                        <div class="mt-1 text-sm text-red-500">
                            Variant unavailable
                        </div>
        
                        <% } %>
        
        </div>

      </div>

      <!-- ACTIONS -->
      <div class="mt-6 border-t pt-4 flex items-center justify-between">

        <!-- ADD TO CART / STATUS -->

        <% if (!item.isActive || item.isDeleted) { %>

          <button
            class="text-sm px-6 py-2 bg-red-500 text-[#FAFAF8] rounded-lg cursor-not-allowed">
            UNAVAILABLE
          </button>

        <% } else if (variant.stock <= 0) { %>

          <button
            class="text-sm px-6 py-2 bg-red-500 text-[#FAFAF8] rounded-lg cursor-not-allowed">
            OUT OF STOCK
          </button>

        <% } else { %>

          <button
            data-product="<%= item.productId %>"
            data-variant="<%= variant.type.toLowerCase() %>"
            class="addCartBtn text-sm px-6 py-2 border hover:bg-[#121212] hover:text-[#FAFAF8] transition rounded-lg">

            ADD TO CART

          </button>

        <% } %>


        <!-- REMOVE -->

        <button
          data-product="<%= item.productId %>"
          data-variant="<%= variant.type.toLowerCase() %>"
          class="removeWishlistBtn text-sm text-[#121212] hover:underline transition">

          REMOVE

        </button>

      </div>

    </div>

    <% }) %>

  </div>

  <% } %>

</section>