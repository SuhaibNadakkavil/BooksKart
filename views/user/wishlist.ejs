<section class="max-w-6xl mx-auto">

  <!-- HEADER -->
  <div class="text-center mb-16">

    <h1 class="text-3xl md:text-4xl font-semibold">
      Your Wishlist
    </h1>

    <p class="mt-3 text-base text-[#121212]/70">
      Books you’ve saved for later.
    </p>

  </div>

  

  <!-- WISHLIST CONTAINER -->
   <div id="wishlistContainer" class="<%= (!wishlistItems || wishlistItems.length === 0) ? 'hidden' : '' %>">

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6">

    <% wishlistItems.forEach(item => { %>

    <div class="wishlist-item rounded-lg bg-white hover:shadow-xl p-6">

      <!-- IMAGE -->
      <a href="/product/<%= item.slug %>">

        <div class="overflow-hidden aspect-[3/4] bg-white flex items-center justify-center group">

          <img 
            src="<%= item.images %>"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 rounded-lg"
          >

        </div>

      </a>

      <!-- DETAILS -->
      <div class="mt-4 space-y-1">

        <h3 class="text-lg font-semibold">
          <%= item.title %>
        </h3>

        <p class="text-sm text-[#121212]/70">
          <%= item.author %>
        </p>

        <!-- VARIANT + PRICE -->
        <div class="text-sm mt-2">
        
            <span class="uppercase tracking-wide text-[#121212]/60">
                <%= item.variantType %>
            </span>

            <% const variant = item.selectedVariant; %>
        
            <% if (variant && variant.salePrice && variant.salePrice !==variant.regularPrice) { %>
        
                <div class="mt-1 flex items-center gap-2">
        
                    <span class="font-semibold text-red-600">
                        ₹<%= variant.salePrice %>
                    </span>
        
                    <span class="line-through text-[#121212]/50">
                        ₹<%= variant.regularPrice %>
                    </span>
        
                </div>
        
                <% } else if (variant) { %>
        
                    <div class="mt-1 font-semibold">
                        ₹<%= variant.regularPrice %>
                    </div>
        
                    <% } else { %>
        
                        <div class="mt-1 text-sm text-red-500">
                            Variant unavailable
                        </div>
        
                        <% } %>
        
        </div>

      </div>

      <!-- ACTIONS -->
      <div class="mt-3 pt-2 flex items-center justify-between">

        <!-- ADD TO CART / STATUS -->

        <% if (!item.isActive || item.isDeleted) { %>

          <button
            class="text-sm px-5 py-2 bg-red-500 text-[#FAFAF8] rounded-lg cursor-not-allowed group">
            <span class="inline-block transition-transform duration-300 group-hover:scale-110">
            UNAVAILABLE
            </span>
          </button>

        <% } else if (variant.stock <= 0) { %>

          <button
            class="text-sm px-4 py-2 bg-red-500 text-[#FAFAF8] rounded-lg cursor-not-allowed group">
            <span class="inline-block transition-transform duration-300 group-hover:scale-110">
            OUT OF STOCK
            </span>
          </button>

        <% } else { %>

          <button
            data-product="<%= item.productId %>"
            data-variant="<%= variant.type.toLowerCase() %>"
            class="addCartBtn text-sm px-5 py-2 bg-[#121212] text-[#FAFAF8] rounded-lg group">
            <span class="inline-block transition-transform duration-300 group-hover:scale-110">
            ADD TO CART
            </span>
          </button>

        <% } %>


        <!-- REMOVE -->

        <button
          data-product="<%= item.productId %>"
          data-variant="<%= variant.type.toLowerCase() %>"
          class="removeWishlistBtn text-sm border rounded-lg text-red-500 px-2 py-1.5 hover:bg-red-500 hover:text-white transition">

          REMOVE

        </button>

      </div>

    </div>

    <% }) %>

  </div>
</div>


<!-- EMPTY STATE -->
   <div id="emptyState" class="<%= (wishlistItems && wishlistItems.length > 0) ? 'hidden' : '' %>">

  <section class="relative min-h-[60vh] flex items-center justify-center">

    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <span class="text-[140px] md:text-[220px] font-semibold text-[#121212]/10">
        ❤️
      </span>
    </div>

    <div class="relative z-10 text-center max-w-xl">

      <h2 class="text-2xl font-semibold">
        Your wishlist is empty
      </h2>

      <p class="mt-4 text-[#121212]/70">
        Start exploring and save books you love.
      </p>

      <div class="mt-8">

        <a href="/shop"
            class="group px-8 py-3 bg-[#121212] text-[#FAFAF8] rounded-md">
            <span class="inline-block transition-transform duration-300 group-hover:scale-110">
                Browse Books
            </span>
        </a>

      </div>

    </div>

  </section>
   </div>

</section>