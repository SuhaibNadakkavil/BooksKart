<section class="min-h-screen flex items-center justify-center bg-[#FAFAF8] px-4">

  <div class="w-full max-w-md border border-[#121212] rounded-3xl p-10">

    <!-- Heading -->
    <div class="text-center mb-10">
      <h1 class="text-3xl font-semibold text-[#121212]">
        Set New Password
      </h1>
    </div>

    <!-- Form -->
    <form
      id="setPasswordForm"
      action="/set-new-password"
      method="POST"
      novalidate
      class="space-y-6"
    >

      <!-- Hidden Email -->
      <input type="hidden" name="email" value="<%= email %>" />

      <!-- New Password -->
      <div>
        <label class="block text-sm font-medium mb-2">
          New Password
        </label>

        <div class="relative">
          <input
            type="password"
            name="password"
            id="password"
            placeholder="Enter your new password"
            class="w-full border border-[#121212] rounded-xl px-4 py-3 pr-12 focus:outline-none focus:border-[#333333] transition"
          />

          <button
            type="button"
            data-toggle="password"
            class="absolute right-4 top-1/2 -translate-y-1/2 text-lg"
          >
            👁
          </button>
        </div>

        <p id="passwordError" class="text-sm text-red-600 mt-1">
          <%= errors?.password || '' %>
        </p>
      </div>

      <!-- Confirm Password -->
      <div>
        <label class="block text-sm font-medium mb-2">
          Confirm New Password
        </label>

        <div class="relative">
          <input
            type="password"
            name="confirmPassword"
            id="confirmPassword"
            placeholder="Confirm your new password"
            class="w-full border border-[#121212] rounded-xl px-4 py-3 pr-12 focus:outline-none focus:border-[#333333] transition"
          />

          <button
            type="button"
            data-toggle="confirmPassword"
            class="absolute right-4 top-1/2 -translate-y-1/2 text-lg"
          >
            👁
          </button>
        </div>

        <p id="confirmPasswordError" class="text-sm text-red-600 mt-1">
          <%= errors?.confirmPassword || '' %>
        </p>
      </div>

      <!-- Submit -->
      <button
        type="submit"
        id="submitBtn"
        class="w-full bg-[#121212] text-[#FAFAF8] py-3 rounded-xl font-medium transition hover:opacity-90 disabled:opacity-60"
      >
        Save
      </button>

    </form>

  </div>

</section>