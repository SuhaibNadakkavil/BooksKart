<section class="space-y-10">

  <!-- Header -->
  <div class="text-center space-y-2">
    <h1 class="text-2xl md:text-3xl font-semibold tracking-tight">CHECKOUT</h1>
    <p class="text-sm opacity-70">Review your collection and complete your purchase.</p>
  </div>

  <!-- Main Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

    <% if (checkoutError) { %>
        <div class="border border-red-500 text-red-600 text-sm px-4 py-3 rounded">
            <%= checkoutError %>
        </div>
        <% } %>

    <!-- LEFT SIDE -->
    <div class="lg:col-span-2 space-y-10">

      <!-- ================= ADDRESS SECTION ================= -->
      <div id="addressList" class="space-y-4">

        <div class="flex items-center justify-between border-b pb-2">
          <h2 class="text-lg font-semibold">DELIVERY ADDRESS</h2>
          <button id="openAddressModal"
             class="text-sm px-4 py-1.5 bg-black text-white group transition rounded-md">
             <span class="inline-block transition-transform duration-300 group-hover:scale-110">
            ADD ADDRESS
             </span>
          </button>
        </div>

        <% if (addresses && addresses.length > 0) { %>

          <div class="space-y-4 max-h-96 overflow-y-auto">

            <% addresses.forEach((address, index) => { %>
              <label class="block bg-white rounded-lg p-4 cursor-pointer hover:shadow-lg transition">

                <div class="flex items-center gap-3">

                  <!-- Radio -->
                  <input 
                    type="radio"
                    name="selectedAddress"
                    value="<%= address._id %>"
                    class="w-4 h-4 accent-black"
                    <%= address.isDefault ? 'checked' : '' %>
                  />

                  <!-- Address Content -->
                  <div class="flex-1 space-y-1">

                    <div class="flex items-center justify-between">

                      <div class="flex items-center gap-2">
                        <p class="font-medium text-base">
                          <%= address.name %>
                        </p>

                        <% if (address.isDefault) { %>
                          <span class="text-xs px-2 py-0.5 border rounded">
                            Default
                          </span>
                        <% } %>
                      </div>

                    <button type="button"
                        class="editAddressBtn text-xs border text-blue-600 hover:text-white hover:bg-blue-600 rounded-md px-2 py-1"
                        data-address='<%- JSON.stringify(address) %>'>
                        EDIT
                    </button>
                    </div>

                    <p class="text-sm leading-relaxed">
                      <%= address.street %>, <%= address.city %>, <%= address.state %> - <%= address.pincode %>
                    </p>

                    <p class="text-sm">
                      Phone: <%= address.phone %>
                    </p>

                  </div>

                </div>

              </label>
            <% }) %>

          </div>

        <% } else { %>

          <!-- Empty State -->
          <div class="bg-white hover:shadow-lg rounded-lg p-6 text-center space-y-3">
            <p class="text-sm opacity-70">No saved addresses found</p>
          </div>

        <% } %>

      </div>

      <!-- ================= PAYMENT SECTION ================= -->
      <div class="space-y-4">

        <div class="border-b pb-2">
          <h2 class="text-lg font-semibold">PAYMENT METHOD</h2>
        </div>

        <div class="space-y-3">

          <% const paymentMethods = [
            { value: "razorpay", label: "RAZORPAY" },
            { value: "cod", label: "CASH ON DELIVERY" },
            { value: "wallet", label: "WALLET" }
          ]; %>

          <% paymentMethods.forEach((method, index) => { %>
            <label class="flex items-center gap-3 rounded-lg p-4 cursor-pointer hover:shadow-lg transition bg-white">

              <input 
                type="radio"
                name="paymentMethod"
                value="<%= method.value %>"
                class="w-4 h-4 accent-black"
                <%= index === 0 ? 'checked' : '' %>
              />

              <span class="text-sm font-medium tracking-wide">
                <%= method.label %>
              </span>

            </label>
          <% }) %>

        </div>

      </div>

    </div>

    <!-- RIGHT SIDE (ORDER SUMMARY) -->
    <div class="bg-white rounded-lg p-6 space-y-6 h-fit sticky top-24 hover:shadow-lg">

      <h2 class="text-lg font-semibold border-b pb-2">ORDER SUMMARY</h2>

      <!-- Items -->
      <div class="space-y-4 max-h-64 overflow-y-auto pr-1">

        <% cartItems.forEach(item => { %>
          <div class="flex gap-3">

            <img 
              src="<%= item.images.cover %>"
              class="w-14 h-20 object-cover rounded"
              alt="<%= item.title %>"
            />

            <div class="flex-1 text-sm space-y-1">
              <p class="font-medium"><%= item.title %></p>
              <p class="opacity-70 text-xs"><%= item.author %></p>
              <p class="text-xs">Qty: <%= item.quantity %></p>
            </div>

            <p class="text-sm font-medium">
              ₹<%= item.itemTotal %>
            </p>

          </div>
        <% }) %>

      </div>

      <!-- Coupon -->
      <div class="space-y-2">
        <p class="text-sm font-medium">COUPON CODE</p>

        <div class="flex gap-2">
          <input 
            type="text"
            placeholder="Enter coupon"
            class="flex-1 border rounded px-3 py-2 text-sm outline-none"
          />
          <button class="px-4 py-2 text-sm bg-[#121212] text-white transition rounded-md group">
            <span class="inline-block transition-transform duration-300 group-hover:scale-110">
            APPLY
            </span>
          </button>
        </div>

        <a href="#" class="text-xs font-semibold hover:underline">
          View Coupon Codes
        </a>
      </div>

      <!-- Price -->
      <div class="text-sm space-y-2 border-t pt-4">

        <div class="flex justify-between">
          <span>Subtotal</span>
          <span>₹<%= subtotal %></span>
        </div>

        <div class="flex justify-between">
          <span>Shipping</span>
          <span>Free</span>
        </div>

        <div class="flex justify-between text-green-600">
          <span>Discount</span>
          <span>₹0</span>
        </div>

      </div>

      <!-- Total -->
      <div class="border-t pt-4 flex justify-between font-semibold text-base">
        <span>TOTAL</span>
        <span>₹<%= subtotal %></span>
      </div>

      <!-- Place Order -->
      <button 
        id="placeOrderBtn"
        class="w-full py-3 text-sm font-medium bg-[#121212] text-[#FAFAF8] rounded-lg transition group disabled:cursor-not-allowed"
        <%= checkoutError || !addresses.length ? 'disabled' : '' %>
      >
      <span class="inline-block transition-transform duration-300 group-hover:scale-110">
        PLACE ORDER
      </span>
      </button>

    </div>

  </div>

</section>

<%- include('../partials/userPartials/checkoutModals') %>