<section class="bg-[#FAFAF8] py-16">

<div class="max-w-7xl mx-auto px-6">

<div class="grid grid-cols-1 md:grid-cols-4 gap-12">

<!-- ============================= -->
<!-- FILTER SIDEBAR -->
<!-- ============================= -->

<aside class="md:col-span-1 md:sticky md:top-28 h-fit text-sm space-y-10">

<!-- CATEGORY -->

<div>
  <h3 class="font-semibold tracking-wide mb-4">CATEGORY</h3>

  <form id="categoryFilterForm" method="GET" action="/shop">
    
    <!-- Preserve other filters -->
    <input type="hidden" name="price" value="<%= query.price || '' %>">
    <input type="hidden" name="sort" value="<%= query.sort || '' %>">
    <input type="hidden" name="search" value="<%= query.search || '' %>">

    <div class="space-y-2">

      <% if (categories && categories.length) { %>
        <% const selectedCategories = (query.category || '').split(','); %>

        <% categories.forEach(cat => { %>

          <label class="flex items-center gap-2 cursor-pointer hover:underline">
            <input type="checkbox"
                   name="category"
                   value="<%= cat.slug %>"
                   class="category-checkbox"
                   <%= selectedCategories.includes(cat.slug) ? 'checked' : '' %> >

            <span><%= cat.name %></span>
          </label>

        <% }) %>
      <% } %>

    </div>

  </form>
</div>


<!-- PRICE RANGE -->

<div>

<h3 class="font-semibold tracking-wide mb-4">PRICE RANGE</h3>

<div class="space-y-2">

<a
href="/shop?price=under200&category=<%= query.category || '' %>&sort=<%= query.sort || '' %>&search=<%= query.search || '' %>"
class="block hover:underline <%= query.price==='under200' ? 'font-semibold' : '' %>">

Under ₹200

</a>


<a
href="/shop?price=200-400&category=<%= query.category || '' %>&sort=<%= query.sort || '' %>&search=<%= query.search || '' %>"
class="block hover:underline <%= query.price==='200-400' ? 'font-semibold' : '' %>">

₹200 – ₹400

</a>


<a
href="/shop?price=400-600&category=<%= query.category || '' %>&sort=<%= query.sort || '' %>&search=<%= query.search || '' %>"
class="block hover:underline <%= query.price==='400-600' ? 'font-semibold' : '' %>">

₹400 – ₹600

</a>


<a
href="/shop?price=above600&category=<%= query.category || '' %>&sort=<%= query.sort || '' %>&search=<%= query.search || '' %>"
class="block hover:underline <%= query.price==='above600' ? 'font-semibold' : '' %>">

Above ₹600

</a>

</div>

</div>


<!-- SORT -->

<div>

<h3 class="font-semibold tracking-wide mb-4">SORT BY</h3>

<div class="space-y-2">

<a
href="/shop?sort=new&category=<%= query.category || '' %>&price=<%= query.price || '' %>&search=<%= query.search || '' %>"
class="block hover:underline <%= query.sort==='new' ? 'font-semibold' : '' %>">

New Arrivals

</a>


<a
href="/shop?sort=priceLow&category=<%= query.category || '' %>&price=<%= query.price || '' %>&search=<%= query.search || '' %>"
class="block hover:underline <%= query.sort==='priceLow' ? 'font-semibold' : '' %>">

Price: Low to High

</a>


<a
href="/shop?sort=priceHigh&category=<%= query.category || '' %>&price=<%= query.price || '' %>&search=<%= query.search || '' %>"
class="block hover:underline <%= query.sort==='priceHigh' ? 'font-semibold' : '' %>">

Price: High to Low

</a>


<a
href="/shop?sort=az&category=<%= query.category || '' %>&price=<%= query.price || '' %>&search=<%= query.search || '' %>"
class="block hover:underline <%= query.sort==='az' ? 'font-semibold' : '' %>">

Title: A to Z

</a>


<a
href="/shop?sort=za&category=<%= query.category || '' %>&price=<%= query.price || '' %>&search=<%= query.search || '' %>"
class="block hover:underline <%= query.sort==='za' ? 'font-semibold' : '' %>">

Title: Z to A

</a>

</div>

</div>


<!-- CLEAR FILTER -->

<div>

<a href="/shop" class="text-sm underline opacity-70 hover:opacity-100">
Clear Filters
</a>

</div>

</aside>



<!-- ============================= -->
<!-- PRODUCT SECTION -->
<!-- ============================= -->

<div class="md:col-span-3">


<!-- HEADER -->

<div class="flex flex-col md:flex-row md:items-center md:justify-between mb-10 gap-6">

<div>

<h1 class="text-2xl font-semibold">Books for you</h1>

<p class="text-sm opacity-70">
Curated reads across self-help and fiction.
</p>

</div>



<!-- SEARCH -->

<form action="/shop" method="GET" class="flex items-center gap-2">

<input
type="text"
name="search"
value="<%= query.search || '' %>"
placeholder="Search by Books"
class="border border-[#121212] px-4 py-2 text-sm w-64 focus:outline-none rounded-lg focus:border-[#333333]"
/>

<!-- preserve filters -->

<input type="hidden" name="category" value="<%= query.category || '' %>">
<input type="hidden" name="price" value="<%= query.price || '' %>">
<input type="hidden" name="sort" value="<%= query.sort || '' %>">

<button class="bg-[#121212] text-[#FAFAF8] rounded-lg px-5 py-2 text-sm group">
<span class="inline-block transition-transform duration-300 group-hover:scale-110">
Search
</span>
</button>

<% if(query?.search){ %>
<a href="/shop" class="text-xs tracking-widest hover:underline">
CANCEL
</a>
<% } %>

</form>

</div>



<!-- ============================= -->
<!-- PRODUCTS GRID -->
<!-- ============================= -->

<div class="grid grid-cols-2 md:grid-cols-3 gap-6">

<% if(!products || products.length === 0){ %>

<p class="text-sm opacity-70">
No books found.
</p>

<% } %>


<% products.forEach(product => { %>

<div class="group space-y-3 relative hover:shadow-xl transition rounded-lg p-6 bg-white">

<a href="/product/<%= product.slug %>">

<div class="overflow-hidden aspect-[3/4]">

<img
src="<%= product.images.cover %>"
class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 rounded-lg"
alt="<%= product.title %>"
>

</div>

</a>



<div class="space-y-1">

<h3 class="text-sm font-medium group-hover:underline">

<%= product.title %>

</h3>

<p class="text-xs opacity-70">

<%= product.author %>

</p>


<%
const regular = product.variants?.[0]?.regularPrice || 0
const sale = product.variants?.[0]?.salePrice || regular
%>


<div class="flex items-center gap-2 text-sm">

<% if(sale < regular){ %>

<span class="font-semibold text-red-600">₹<%= sale %></span>

<span class="line-through opacity-50 text-xs">

₹<%= regular %>

</span>

<span class="text-xs font-semibold text-green-600">

<% if(product.productOffer){ %>
    <% if(product.productOffer.type==="percentage" ){ %>
        <%= product.productOffer.value %>% OFF
    <% } else { %>
        ₹<%= product.productOffer.value %> OFF
    <% } %>
<% } else if(!product.productOffer && product.category?.offer){ %>
        <% if(product.category?.offer.type==="percentage" ){ %>
            <%= product.category.offer.value %>% OFF
        <% } else { %>
            ₹<%= product.category.offer.value %> OFF
        <% } %>
    <% } %>

</span>

<% } else { %>

<span class="font-semibold">₹<%= regular %></span>

<% } %>

</div>

</div>



<!-- ACTIONS -->

<div class="flex items-center gap-3 pt-2">

<% if(product.variants?.[0]?.stock > 0){ %>

<button
data-product="<%= product._id %>"
data-variant="<%= product.variants[0]?.type %>"
class="addCartBtn flex-1 text-sm bg-[#121212] text-[#FAFAF8] py-2 group rounded-lg">
<span class="inline-block transition-transform duration-300 group-hover:scale-110">
Add to Cart
</span>
</button>

<% } else { %>

<div class="flex-1 text-center text-sm py-2 bg-red-600 text-[#FAFAF8] rounded-lg group">
<span class="inline-block transition-transform duration-300 group-hover:scale-110">
Out of Stock
</span>
</div>

<% } %>


<button
data-product="<%= product._id %>"
data-variant="<%= product.variants[0].type.toLowerCase() %>"
class="wishlistBtn p-1 text-red-600 hover:bg-red-600 hover:text-white transition rounded-lg">

<svg xmlns="http://www.w3.org/2000/svg"
class="w-6 h-6 wishlistIcon"
fill="none"
viewBox="0 0 24 24"
stroke="currentColor"
stroke-width="1.7">

<path stroke-linecap="round"
stroke-linejoin="round"
d="M4.318 6.318a4.5 4.5 0 016.364 0L12 7.636l1.318-1.318a4.5 4.5 0 116.364 6.364L12 20.364 4.318 12.682a4.5 4.5 0 010-6.364z" />

</svg>

</button>

</div>

</div>

<% }) %>

</div>



<!-- ============================= -->
<!-- PAGINATION -->
<!-- ============================= -->

<div class="flex flex-col md:flex-row md:items-center md:justify-between mt-12 text-sm">

<p class="opacity-70 mb-4 md:mb-0">

Showing <%= products?.length || 0 %> of <%= totalProducts || 0 %> products

</p>


<div class="flex items-center gap-4">

<% if(page > 1){ %>

<a
href="?search=<%= query.search || '' %>&category=<%= query.category || '' %>&price=<%= query.price || '' %>&sort=<%= query.sort || '' %>&page=<%= page - 1 %>"
class="hover:underline">

← Previous

</a>

<% } %>



<div class="flex items-center gap-2">

<% for(let i=1; i<=totalPages; i++){ %>

<a
href="?search=<%= query.search || '' %>&category=<%= query.category || '' %>&price=<%= query.price || '' %>&sort=<%= query.sort || '' %>&page=<%= i %>"
class="px-2 <%= page===i ? 'font-semibold underline' : 'hover:underline' %>">

<%= i %>

</a>

<% } %>

</div>


<% if(page < totalPages){ %>

<a
href="?search=<%= query.search || '' %>&category=<%= query.category || '' %>&price=<%= query.price || '' %>&sort=<%= query.sort || '' %>&page=<%= page + 1 %>"
class="hover:underline">

Next →

</a>

<% } %>

</div>

</div>

</div>

</div>

</div>

</section>