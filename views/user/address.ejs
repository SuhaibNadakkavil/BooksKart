<section class="flex min-h-screen bg-[#FAFAF8]">

  <!-- Sidebar -->
  <%- include("../partials/userPartials/sidebar", { activePage }) %>

  <!-- Main Content -->
  <div class="flex-1 px-6 py-10 lg:px-12">

    <!-- Mobile Header Row -->
    <div class="flex items-center gap-4 mb-8 lg:hidden">
      <button id="sidebarToggle"
              class="text-[20px] font-semibold leading-none">
        ☰
      </button>
      <h1 class="font-playfair text-[36px] font-semibold">
        Address
      </h1>
    </div>

    <!-- Header -->
    <div class="flex items-center justify-between mb-8">

      <div class="hidden lg:block mb-10">
        <h1 class="font-playfair text-[36px] font-semibold leading-tight">
          Address
        </h1>
      </div>

      <a
        href="/profile/address/add"
        class="group px-6 py-3 rounded-lg font-medium bg-[#121212] text-white">
        <span class="inline-block transition-transform duration-300 group-hover:scale-110">
        ADD ADDRESS
        </span>
      </a>

    </div>


    <!-- ADDRESS LIST -->
    <% if (addresses && addresses.length > 0) { %>

      <div class="space-y-6">

        <% addresses.forEach(address => { %>

          <div
            class="border border-[#121212] rounded-xl p-6 flex flex-col md:flex-row md:justify-between md:items-start gap-6 transition hover:shadow-md"
          >

            <!-- Address Info -->
            <div>

              <h3 class="text-lg font-semibold text-[#121212] mb-2 flex items-center gap-2">

                <%= address.name %>

                <% if (address.isDefault) { %>
                  <span class="text-xs px-3 py-1 border border-[#121212] rounded-full font-medium">
                    DEFAULT
                  </span>
                <% } %>

              </h3>

              <p class="text-gray-600 leading-relaxed">
                <%= address.street %>, <%= address.area %><br>
                <%= address.city %>, <%= address.state %> <%= address.pincode %><br>
                <%= address.country %> &nbsp; <%= address.phone %>
              </p>

            </div>


            <!-- Actions -->
            <div class="flex md:flex-col gap-2 text-sm font-medium">

              <a
                href="/profile/address/edit/<%= address._id %>"
                class="border text-[#121212] px-2 py-1.5 rounded-md hover:bg-black hover:text-white ">
                EDIT ADDRESS
              </a>

            <% if (!address.isDefault) { %>
              <button
                data-id="<%= address._id %>"
                class="border text-red-600 px-2 py-1.5 rounded-md hover:bg-red-600 hover:text-white deleteAddressBtn">
                DELETE
              </button>
            <% } %>

            </div>

          </div>

        <% }) %>

      </div>

    <% } else { %>


      <!-- EMPTY STATE -->
      <div class="flex flex-col items-center justify-center py-32 text-center">

        <h3 class="text-xl font-semibold text-[#121212] mb-2">
          No Addresses Found
        </h3>

        <p class="text-gray-500 mb-6">
          You haven't added any shipping address yet.
        </p>

      </div>

    <% } %>

  </div>

</section>