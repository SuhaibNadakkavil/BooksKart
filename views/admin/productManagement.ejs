<section class="w-full">

    <!-- PAGE HEADER -->
    <div class="flex items-center justify-between mb-8">

        <div>
            <h1 class="text-xl font-medium">Product Management</h1>
            <div class="w-12 h-[2px] bg-[#121212] mt-2"></div>
        </div>

        <a href="/admin/products/add"
            class="bg-[#121212] text-[#FAFAF8] rounded-lg px-5 py-2 text-sm tracking-widest group">
            <span class="inline-block transition-transform duration-300 group-hover:scale-110">
            ADD PRODUCT
            </span>
        </a>

    </div>



    <!-- SEARCH / FILTER / SORT -->
    <form method="GET" action="/admin/products"
        class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 mb-10">


        <!-- SEARCH -->
        <div class="flex items-center gap-3">

            <input type="text" name="search" value="<%= query?.search || '' %>"
                placeholder="Search by title or author..." class="border border-[#121212] rounded-lg px-3 py-2 w-72
             focus:outline-none focus:border-[#333333]" />

            <button type="submit"
                class="bg-[#121212] text-[#FAFAF8] rounded-lg px-4 py-2 text-sm tracking-widest group">
                <span class="inline-block transition-transform duration-300 group-hover:scale-110">
                SEARCH
                </span>
            </button>

            <% if(query?.search){ %>
                <a href="/admin/products" class="text-xs tracking-widest hover:underline">
                    CANCEL
                </a>
                <% } %>

        </div>


        <!-- FILTER + SORT -->
        <div class="flex items-center gap-6 text-sm tracking-widest">

            <!-- FILTER -->
            <select id="statusFilter" name="status" class="border border-[#121212] px-3 py-2 rounded-lg
             focus:outline-none focus:border-[#333333]">

                <option value="">FILTER</option>

                <option value="active" <%=query?.status==="active" ? "selected" : "" %>>
                    Active
                </option>

                <option value="inactive" <%=query?.status==="inactive" ? "selected" : "" %>>
                    Inactive
                </option>

            </select>


            <!-- SORT -->
            <select id="sortSelect" name="sort" class="border border-[#121212] px-3 py-2 rounded-lg
             focus:outline-none focus:border-[#333333]">

                <option value="new" <%=query?.sort==="new" ? "selected" : "" %>>
                    Newest
                </option>

                <option value="old" <%=query?.sort==="old" ? "selected" : "" %>>
                    Oldest
                </option>

                <option value="az" <%=query?.sort==="az" ? "selected" : "" %>>
                    A-Z
                </option>

                <option value="za" <%=query?.sort==="za" ? "selected" : "" %>>
                    Z-A
                </option>

                <option value="priceLow" <%=query?.sort==="priceLow" ? "selected" : "" %>>
                    Price Low → High
                </option>

                <option value="priceHigh" <%=query?.sort==="priceHigh" ? "selected" : "" %>>
                    Price High → Low
                </option>

            </select>

        </div>

    </form>



    <!-- PRODUCT TABLE -->
    <div class="overflow-x-auto">

        <table class="w-full text-sm">

            <thead>

                <tr class="border-b border-gray-300 text-left text-xs tracking-widest uppercase">

                    <th class="py-4">Product</th>
                    <th>Category</th>
                    <th>Offer</th>
                    <th>Variant Details</th>
                    <th>Status</th>
                    <th class="text-right">Actions</th>

                </tr>

            </thead>



            <tbody>

                <% if(products && products.length> 0){ %>

                    <% products.forEach(product=> { %>

                        <tr class="border-b border-gray-200 hover:bg-gray-50 transition">

                            <!-- PRODUCT INFO -->
                            <td class="py-5 max-w-xs">

                                <div class="font-medium">
                                    <%= product.title %>
                                </div>

                                <div class="text-xs opacity-70">
                                    <%= product.author %>
                                </div>

                            </td>



                            <!-- CATEGORY -->
                            <td>

                                <div>
                                    <%= product.category?.name || "-" %>
                                </div>

                                <% if(!product.productOffer && product.category?.offer){ %>

                                    <div class="text-xs text-green-600 opacity-70">
                                        <% if(product.category?.offer.type==="percentage" ){ %>
                                            <%= product.category.offer.value %>% OFF
                                                <% } else { %>
                                                    ₹<%= product.category.offer.value %> OFF
                                                        <% } %>
                                    </div>
                                    <% } else if(product.productOffer && product.category?.offer){ %>

                                        <div class="text-xs line-through text-green-600 opacity-70">
                                            <% if(product.category?.offer.type==="percentage" ){ %>
                                                <%= product.category.offer.value %>% OFF
                                                    <% } else { %>
                                                        ₹<%= product.category.offer.value %> OFF
                                                            <% } %>
                                        </div>

                                        <% } %>

                            </td>



                            <!-- PRODUCT OFFER -->
                            <td>

                                <% if(product.productOffer){ %>

                                    <div class="flex flex-col gap-1">

                                        <span class="text-sm text-green-600">

                                            <% if(product.productOffer.type==="percentage" ){ %>
                                                <%= product.productOffer.value %>% OFF
                                                    <% } else { %>
                                                        ₹<%= product.productOffer.value %> OFF
                                                            <% } %>

                                        </span>

                                        <div class="text-xs flex gap-2">
                                        
                                            <% if(product.isActive){ %>
                                        
                                                <button class="border rounded-md px-1 py-0.5 text-blue-600 hover:bg-blue-600 hover:text-white transition editProductOfferBtn" data-id="<%= product._id %>"
                                                    data-type="<%= product.productOffer.type %>" data-value="<%= product.productOffer.value %>"
                                                    data-expiry="<%= product.productOffer.expiryDate.toISOString().split('T')[0] %>">
                                                    EDIT
                                                </button>
                                        
                                                <button class="border rounded-md px-1 py-0.5 text-red-600 hover:bg-red-600 hover:text-white transition deleteProductOfferBtn" data-id="<%= product._id %>">
                                                    REMOVE
                                                </button>
                                        
                                                <% } else { %>
                                        
                                                    <button class="opacity-40 cursor-not-allowed border rounded-md px-1 py-0.5 text-blue-600 hover:bg-blue-600 hover:text-white transition" disabled>
                                                        EDIT
                                                    </button>
                                        
                                                    <button class="opacity-40 cursor-not-allowed border rounded-md px-1 py-0.5 text-red-600 hover:bg-red-600 hover:text-white transition" disabled>
                                                        REMOVE
                                                    </button>
                                        
                                                    <% } %>
                                        
                                        </div>

                                    </div>

                                    <% } else { %>

                                        <div class="flex items-center gap-2">

                                            <span class="opacity-70">None</span>

                                            <% if(product.isActive){ %>
                                            
                                                <button class="text-xs border rounded-md px-1 py-0.5 text-black hover:bg-black hover:text-white transition addProductOfferBtn" data-id="<%= product._id %>">
                                                    ADD
                                                </button>
                                            
                                                <% } else { %>
                                            
                                                    <button class="text-xs opacity-40 border rounded-md px-1 py-0.5 text-black hover:bg-black hover:text-white transition cursor-not-allowed" disabled>
                                                        ADD
                                                    </button>
                                            
                                                    <% } %>

                                        </div>

                                        <% } %>

                            </td>



                            <!-- VARIANT -->
                            <td>
                                <button class="text-xs border rounded-md px-2 py-1 hover:bg-black hover:text-white transition viewVariantsBtn"
                                    data-product='<%- JSON.stringify(product.variants) %>' data-title="<%= product.title %>">
                                    VIEW
                                </button>
                            </td>



                            <!-- STATUS -->
                            <td>

                                <% if(product.isActive){ %>

                                    <span class="text-green-600">
                                        ACTIVE
                                    </span>

                                    <% } else { %>

                                        <span class="text-red-600">
                                            INACTIVE
                                        </span>

                                        <% } %>

                            </td>



                            <!-- ACTIONS -->
                            <td class="text-right space-x-4">

                                <a href="/admin/products/<%= product._id %>/edit"
                                    class="text-sm tracking-widest border rounded-md px-1 py-0.5 text-blue-600 hover:bg-blue-600 hover:text-white transition">
                                    EDIT
                                </a>

                                <% if(product.isActive){ %>

                                    <button class="text-sm tracking-widest border rounded-md px-1 py-0.5 text-red-600 hover:bg-red-600 hover:text-white transition deactivateProductBtn"
                                        data-id="<%= product._id %>">
                                        DEACTIVATE
                                    </button>

                                    <% } else { %>

                                        <button class="text-sm tracking-widest border rounded-md px-1 py-0.5 text-red-600 hover:bg-red-600 hover:text-white transition activateProductBtn"
                                            data-id="<%= product._id %>">
                                            ACTIVATE
                                        </button>

                                        <% } %>

                            </td>

                        </tr>

                        <% }) %>

                            <% } else { %>

                                <tr>
                                    <td colspan="9" class="text-center py-12 opacity-70">
                                        No products found
                                    </td>
                                </tr>

                                <% } %>

            </tbody>

        </table>

    </div>



    <!-- PAGINATION -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mt-8 text-sm">

        <p class="opacity-70 mb-4 md:mb-0">

            Showing <%= products?.length || 0 %> of <%= totalProducts || 0 %> products

        </p>


        <div class="flex items-center gap-4">

            <% if(page> 1){ %>

                <a href="?search=<%= query.search || '' %>&status=<%= query.status || '' %>&sort=<%= query.sort || '' %>&page=<%= page - 1 %>"
                    class="hover:underline">
                    ← Previous
                </a>

                <% } %>


                    <div class="flex items-center gap-2">

                        <% for(let i=1; i <=totalPages; i++){ %>

                            <a href="?search=<%= query.search || '' %>&status=<%= query.status || '' %>&sort=<%= query.sort || '' %>&page=<%= i %>"
                                class="px-2 <%= page === i ? 'font-semibold underline' : 'hover:underline' %>">

                                <%= i %>

                            </a>

                            <% } %>

                    </div>


                    <% if(page < totalPages){ %>

                        <a href="?search=<%= query.search || '' %>&status=<%= query.status || '' %>&sort=<%= query.sort || '' %>&page=<%= page + 1 %>"
                            class="hover:underline">
                            Next →
                        </a>

                        <% } %>

        </div>

    </div>

</section>

<%- include('../partials/adminPartials/productManagementModals') %>