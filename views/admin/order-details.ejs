                  <div class="w-2 h-2 bg-[#121212] rounded-full mt-2"></div>
                  <div>
                    <p class="font-medium">Delivered</p>
                  </div>
                </div>
              <% } %> -->


              <!-- ================= SHIPPED ================= -->
              <!-- <% if(
                ["shipped","out_for_delivery","delivered","return_requested"].includes(order.orderStatus) ||
                anyReturned ||
