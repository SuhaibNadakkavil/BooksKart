                </div>
              <% } %> -->


              <!-- ================= PAYMENT ================= -->
              <!-- <div class="flex gap-3">
                <div class="w-2 h-2 border bg-[#121212] rounded-full mt-2"></div>
                <div>
                  <p>Payment Confirmed</p>
                </div>
              </div> -->


              <!-- ================= CREATED ================= -->
              <!-- <div class="flex gap-3">
                <div class="w-2 h-2 border bg-[#121212] rounded-full mt-2"></div>
                <div>
                  <p>Order Received</p>
                </div>
              </div>

            </div>

          </div> -->

    </div>

  </div>

</section>