                  <div class="w-2 h-2 bg-[#121212] rounded-full mt-2"></div>
                  <div>
                    <p class="font-medium">
                      <%= allReturned ? "Returned" : "Partially Returned" %>
                    </p>
                  </div>
                </div>
              <% } %> -->


              <!-- ================= DELIVERED ================= -->
              <!-- <% if(
                order.orderStatus === "delivered" ||
