<div class="space-y-10">

  <!-- HEADER -->
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">

    <div>
      <h1 class="text-[24px] font-semibold">
        Sales Report
      </h1>
      <p class="text-[16px] opacity-70 mt-1">
        Analyze orders, revenue, discounts and refunds.
      </p>
    </div>

    <div class="flex gap-3">
      <a href="/admin/sales-report/export/pdf?from=<%= filters.from %>&to=<%= filters.to %>"
         class="px-4 py-2 text-sm border border-[#121212] hover:bg-[#121212] hover:text-[#FAFAF8] transition rounded-md">
        Export PDF
      </a>

      <a href="/admin/sales-report/export/excel?from=<%= filters.from %>&to=<%= filters.to %>"
         class="px-4 py-2 text-sm border border-[#121212] hover:bg-[#121212] hover:text-[#FAFAF8] transition rounded-md">
        Export Excel
      </a>
    </div>

  </div>


  <!-- FILTERS -->
  <form method="GET" action="/admin/sales-report"
        class="flex flex-col lg:flex-row gap-4 items-end">

    <div class="flex flex-col">
      <label class="text-sm mb-1">From Date</label>
      <input type="date"
             name="from"
             value="<%= filters.from %>"
             class="border px-3 py-2 text-sm rounded outline-none" />
    </div>

    <div class="flex flex-col">
      <label class="text-sm mb-1">To Date</label>
      <input type="date"
             name="to"
             value="<%= filters.to %>"
             class="border px-3 py-2 text-sm rounded outline-none" />
    </div>

    <div class="flex gap-2">

      <button type="submit"
              class="px-4 py-2 text-sm bg-[#121212] text-[#FAFAF8] rounded-md hover:opacity-80">
        Apply
      </button>

      <a href="/admin/sales-report"
         class="px-4 py-2 text-sm hover:underline">
        Clear
      </a>

    </div>

  </form>


  <!-- SUMMARY CARDS -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

    <!-- Orders -->
    <div class="p-6 rounded-lg bg-white hover:shadow-lg transition space-y-2">
      <p class="text-sm opacity-70 font-bold">Total Orders</p>
      <h2 class="text-[24px] font-semibold">
        <%= summary.totalOrders %>
      </h2>
    </div>

    <!-- Revenue -->
    <div class="p-6 rounded-lg bg-white hover:shadow-lg space-y-2">
      <p class="text-sm opacity-70">Gross Revenue</p>
      <h2 class="text-[24px] font-semibold">
        ₹<%= summary.grossRevenue %>
      </h2>
    </div>

    <!-- Discount -->
    <div class="p-6 rounded-lg bg-white hover:shadow-lg space-y-2">
      <p class="text-sm opacity-70">Discounts</p>
      <h2 class="text-[24px] font-semibold">
        ₹<%= summary.totalDiscount %>
      </h2>
    </div>

    <!-- Net -->
    <div class="p-6 rounded-lg bg-white hover:shadow-lg space-y-2">
      <p class="text-sm opacity-70">Net Revenue</p>
      <h2 class="text-[24px] font-semibold">
        ₹<%= summary.netRevenue %>
      </h2>
    </div>

  </div>


  <!-- TABLE -->
  <div class="space-y-4">

    <h2 class="text-[20px] font-semibold">
      Detailed Sales
    </h2>

    <% if (!tableData.length) { %>

      <!-- EMPTY STATE -->
      <div class="text-center py-16 opacity-70">
        <p>No transactions found</p>
        <p class="text-sm mt-2">
          Try adjusting your date range
        </p>
      </div>

    <% } else { %>

      <div class="overflow-x-auto">

        <table class="w-full text-sm">

          <!-- HEADER -->
          <thead class="border-b">
            <tr class="text-left">

              <th class="py-3">Order ID</th>
              <th class="py-3">Date</th>
              <th class="py-3">Method</th>
              <th class="py-3">Status</th>
              <th class="py-3 text-right">Gross</th>
              <th class="py-3 text-right">Discount</th>
              <th class="py-3 text-right">Refund</th>
              <th class="py-3 text-right">Net</th>

            </tr>
          </thead>

          <!-- BODY -->
          <tbody>

            <% tableData.forEach(order => { %>

              <tr class="border-b hover:bg-gray-50 transition">

                <td class="py-3">
                  #<%= order.orderId %>
                </td>

                <td class="py-3">
                  <%= new Date(order.date).toLocaleDateString() %>
                </td>

                <td class="py-3">
                  <%= order.paymentMethod %>
                </td>

                <td class="py-3">
                  <%= order.status %>
                </td>

                <td class="py-3 text-right">
                  ₹<%= order.gross %>
                </td>

                <td class="py-3 text-right">
                  ₹<%= order.discount %>
                </td>

                <td class="py-3 text-right">
                  ₹<%= order.refund %>
                </td>

                <td class="py-3 text-right font-medium">
                  ₹<%= order.net %>
                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    <% } %>

  </div>

  <!-- PAGINATION -->
<% if (pagination.totalPages > 1) { %>

<div class="flex justify-between items-center mt-6 text-sm">

  <!-- LEFT -->
  <p>
    Page <%= pagination.currentPage %> of <%= pagination.totalPages %>
  </p>

  <!-- RIGHT -->
  <div class="flex gap-2">

    <% if (pagination.currentPage > 1) { %>
      <button class="page-btn px-3 py-1 border"
              data-page="<%= pagination.currentPage - 1 %>">
        Prev
      </button>
    <% } %>

    <% for (let i = 1; i <= pagination.totalPages; i++) { %>

      <button
        class="page-btn px-3 py-1 border <%= i === pagination.currentPage ? 'bg-[#121212] text-white' : '' %>"
        data-page="<%= i %>">

        <%= i %>

      </button>

    <% } %>

    <% if (pagination.currentPage < pagination.totalPages) { %>
      <button class="page-btn px-3 py-1 border"
              data-page="<%= pagination.currentPage + 1 %>">
        Next
      </button>
    <% } %>

  </div>

</div>

<% } %>

</div>